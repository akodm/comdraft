{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "schedules": {
    "sitemap-weekly": {
      "schedule": "0 0 * * 0",
      "timezone": "Asia/Seoul",
      "path": "/api/cron/sitemap",
      "requestMethod": "GET"
    },
    "daily-report": {
      "schedule": "0 8 * * *",
      "timezone": "Asia/Seoul",
      "path": "/api/cron/daily-report",
      "requestMethod": "GET"
    },
    "uploads-cleanup": {
      "schedule": "0 * * * *",
      "timezone": "Asia/Seoul",
      "path": "/api/cron/uploads-cleanup",
      "requestMethod": "GET"
    }
  }
}
