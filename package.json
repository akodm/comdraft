{
  "name": "next-app-boilerplate",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.11.0",
    "pnpm": ">=11.24.0"
  },
  "scripts": {
    "dev": "next dev -p 3003",
    "build": "pnpm i18n:compile && next build",
    "start": "next start -p 3003",
    "eslint": "eslint . --ext .ts,.tsx,.js,.jsx --cache --fix",
    "i18n:extract": "lingui extract --clean",
    "i18n:compile": "lingui compile",
    "db:generate": "dotenv -e .env.development -- drizzle-kit generate",
    "db:migrate:local": "dotenv -e .env.development -- drizzle-kit migrate",
    "db:migrate:prod": "dotenv -e .env.production -- drizzle-kit migrate",
    "db:studio:local": "dotenv -e .env.development -- drizzle-kit studio",
    "db:studio:prod": "dotenv -e .env.production -- drizzle-kit studio",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.10",
    "@lingui/core": "6.12.0",
    "@lingui/react": "6.12.0",
    "@octokit/app": "16.1.4",
    "@supabase/supabase-js": "^2.119.0",
    "@tiptap/core": "3.33.0",
    "@tiptap/extension-code-block": "3.33.0",
    "@tiptap/extension-image": "3.33.0",
    "@tiptap/extensions": "3.33.0",
    "@tiptap/markdown": "3.33.0",
    "@tiptap/pm": "3.33.0",
    "@tiptap/react": "3.33.0",
    "@tiptap/starter-kit": "3.33.0",
    "@tiptap/static-renderer": "3.33.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.0",
    "@vercel/speed-insights": "^2.0.0",
    "aws4fetch": "1.0.20",
    "better-auth": "1.7.10",
    "dayjs": "^1.11.23",
    "drizzle-orm": "0.45.4",
    "embla-carousel-react": "^8.6.0",
    "motion": "^13.4.0",
    "negotiator": "1.1.0",
    "next": "16.3.5",
    "postgres": "3.4.9",
    "qs": "^6.16.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "0.35.4",
    "tailwind-scrollbar-hide": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.4",
    "@eslint/js": "^9.39.3",
    "@lingui/cli": "6.12.0",
    "@lingui/swc-plugin": "6.6.0",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/negotiator": "^0.6.5",
    "@types/node": "^20",
    "@types/qs": "^6.15.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv-cli": "11.0.0",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "15.5.12",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-no-relative-import-paths": "^1.6.1",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.56.1",
    "vitest": "^5.1.0"
  }
}
